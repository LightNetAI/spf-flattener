# SPF Flattener — git ignore

# Local configuration with credentials
config/config.local.php
config/*.local.php

# Logs
logs/
*.log

# Database files
*.sqlite
*.db

# Uploads / cache
uploads/
cache/
tmp/
temp/
*.tmp

# Environment files
.env
.env.local
.env.*.local

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Dependencies / build output
vendor/
node_modules/
build/
dist/
*.tar.gz
*.zip
